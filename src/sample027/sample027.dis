                    RRA                                     ;[C004] 1F
                    LD      A,L                             ;[C005] 7D
                    RRA                                     ;[C006] 1F
                    XOR     H                               ;[C007] AC
                    LD      H,A                             ;[C008] 67
                    LD      A,H                             ;[C009] 7C
                    RRA                                     ;[C00A] 1F
                    XOR     L                               ;[C00B] AD
